<?xml version="1.0" encoding="utf-8"?>
<!-- All settings on one page, with only what matters for Spirit Tracks. Advanced settings are folded away under "More options" -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
            android:title="@string/settings_section_graphics"
            app:iconSpaceReserved="false">

        <SwitchPreference
                android:key="battery_saver"
                android:title="@string/settings_battery_saver"
                android:summary="@string/settings_battery_saver_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <ListPreference
                android:key="video_internal_resolution"
                android:title="@string/internal_resolution"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_internal_resolution_options"
                android:entryValues="@array/video_internal_resolution_values"
                android:defaultValue="auto"/>

        <SwitchPreference
                android:key="cel_shading"
                android:title="@string/settings_cel_shading"
                android:summary="@string/settings_cel_shading_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="cutscene_auto_swap"
                android:title="@string/cutscene_auto_swap"
                android:summary="@string/cutscene_auto_swap_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="animated_background"
                android:title="@string/animated_background"
                android:summary="@string/animated_background_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <ListPreference
                android:key="background_style"
                android:title="@string/background_style"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:dependency="animated_background"
                android:entries="@array/background_style_options"
                android:entryValues="@array/background_style_values"
                android:defaultValue="countryside"/>

        <ListPreference
                android:key="background_train"
                android:title="@string/background_train"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:dependency="animated_background"
                android:entries="@array/background_train_options"
                android:entryValues="@array/background_train_values"
                android:defaultValue="spirit"/>
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/settings_section_controls"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="control_style"
                android:title="@string/control_style"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/control_style_options"
                android:entryValues="@array/control_style_values"
                android:defaultValue="stick" />

        <SwitchPreference
                android:key="button_labels"
                android:title="@string/button_labels"
                android:summary="@string/button_labels_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="input_touch_haptic_feedback_enabled"
                android:title="@string/vibrate_on_touch"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <SeekBarPreference
                android:key="input_opacity"
                android:title="@string/soft_input_opacity"
                app:iconSpaceReserved="false"
                android:defaultValue="50"
                android:max="100" />

        <Preference
                android:key="input_key_mapping"
                android:title="@string/key_mapping"
                android:summary="@string/key_mapping_summary"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/settings_section_sound"
            app:iconSpaceReserved="false">

        <SeekBarPreference
                android:key="volume"
                android:title="@string/volume"
                app:iconSpaceReserved="false"
                app:updatesContinuously="true"
                android:defaultValue="256"
                app:min="0"
                android:max="256" />

        <ListPreference
                android:key="sound_quality"
                android:title="@string/settings_sound_quality"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/sound_quality_options"
                android:entryValues="@array/sound_quality_values"
                android:defaultValue="cubic" />

        <ListPreference
                android:key="mic_source"
                android:title="@string/microphone_source"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/mic_source_options"
                android:entryValues="@array/mic_source_values"
                android:defaultValue="blow" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/settings_section_saves"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="auto_save_interval"
                android:title="@string/auto_save"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/auto_save_interval_options"
                android:entryValues="@array/auto_save_interval_values"
                android:defaultValue="15" />

        <SwitchPreference
                android:key="skip_start_screen"
                android:title="@string/launch_last_game_on_startup"
                android:summary="@string/launch_last_game_on_startup_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <Preference
                android:key="game_folder"
                android:title="@string/settings_game_folder"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <!-- Folded away: only a "More options" row shows until it's tapped -->
    <PreferenceCategory
            android:key="more_options"
            android:title="@string/settings_section_more"
            app:initialExpandedChildrenCount="0"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="video_screen_fit"
                android:title="@string/screen_fit"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_screen_fit_options"
                android:entryValues="@array/video_screen_fit_values"
                android:defaultValue="single_screen"/>

        <ListPreference
                android:key="video_renderer"
                android:title="@string/renderer"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_renderer_options"
                android:entryValues="@array/video_renderer_values"
                android:defaultValue="opengl"/>

        <ListPreference
                android:key="fps_counter_position"
                android:title="@string/fps_counter_position"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/fps_counter_position_options"
                android:entryValues="@array/fps_counter_position_values"
                android:defaultValue="hidden" />

        <ListPreference
                android:key="fast_forward_speed_multiplier"
                android:title="@string/fast_forward_max_speed"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/fast_forward_speed_multiplier_options"
                android:entryValues="@array/fast_forward_speed_multiplier_values"
                android:defaultValue="-1" />

        <com.smp.masterswitchpreference.MasterSwitchPreference
                android:key="enable_rewind"
                android:title="@string/rewind"
                app:iconSpaceReserved="false"
                android:fragment="me.magnum.melonds.ui.settings.fragments.RewindPreferencesFragment"
                android:defaultValue="false"
                app:ms_switchOnText="@string/on"
                app:ms_switchOffText="@string/off"
                app:ms_switchThumbColor="?android:colorAccent"
                app:ms_switchTrackColor="@color/prefSwitchRailColor"
                app:ms_switchOnBackgroundColor="@color/prefSwitchBackground"
                app:ms_switchOffBackgroundColor="@color/prefSwitchBackground"
                app:ms_switchOffExplanationText="@string/rewind_description"
                app:ms_includedPrefScreen="xml/pref_rewind" />

        <SwitchPreference
                android:key="enable_sustained_performance"
                android:title="@string/sustained_performance_mode"
                android:summary="@string/sustained_performance_mode_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <Preference
                android:title="@string/cheats"
                android:summary="@string/cheats_summary"
                app:iconSpaceReserved="false"
                android:fragment="me.magnum.melonds.ui.settings.fragments.CheatsPreferencesFragment" />

        <Preference
                android:key="backup_settings"
                android:title="@string/backup_settings"
                app:isPreferenceVisible="@bool/settings_backup_restore_enabled"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="restore_settings"
                android:title="@string/restore_settings"
                app:isPreferenceVisible="@bool/settings_backup_restore_enabled"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
